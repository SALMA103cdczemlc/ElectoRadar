rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rumeurs/{id}  { allow read: if true; allow write: if false; }
    match /scores/{id}   { allow read: if true; allow write: if false; }
    match /verdicts/{id} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
